#!/usr/bin/env bash
# brave-origin-install — one-command Guix System + Brave Origin installer
#
# Usage:
#   bash /etc/brave-origin-templates/brave-origin-install /dev/sdX
#   bash /etc/brave-origin-templates/brave-origin-install /dev/nvme0n1
#
# Partition layout:
#   1 GB   EFI   (FAT32, /boot/efi)
#   4 GB   swap
#   4 GB   /gnu  (Guix store — keeps root small and clean)
#   rest   /     (root, ext4)
#
# What it does:
#   1. Wipes and partitions the target disk
#   2. Formats and mounts all partitions
#   3. Writes /mnt/etc/config.scm (UUIDs, password, hostname filled in)
#   4. Pulls the brave-origin channel
#   5. Runs guix system init — Brave Origin fetched here, not from the ISO
#
set -euo pipefail

red()    { printf '\033[1;31m%s\033[0m\n' "$*"; }
green()  { printf '\033[1;32m%s\033[0m\n' "$*"; }
yellow() { printf '\033[1;33m%s\033[0m\n' "$*"; }
bold()   { printf '\033[1m%s\033[0m\n'   "$*"; }
die()    { red "ERROR: $*"; exit 1; }

[[ $EUID -eq 0 ]] || die "Run as root"

DISK="${1:-}"
[[ -n "$DISK" ]] || { bold "Usage: bash /etc/brave-origin-templates/brave-origin-install /dev/sdX"; exit 1; }
[[ -b "$DISK" ]] || die "$DISK is not a block device"

if [[ "$DISK" =~ nvme|mmcblk ]]; then
  P() { echo "${DISK}p${1}"; }
else
  P() { echo "${DISK}${1}"; }
fi

EFI="$(P 1)"
SWAP="$(P 2)"
STORE="$(P 3)"
ROOT="$(P 4)"

bold "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
bold " Brave Origin Guix System Installer"
bold "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo
yellow "  Target disk : $DISK"
yellow "  Layout:"
yellow "    $(P 1)  →  1 GB   EFI   (FAT32, /boot/efi)"
yellow "    $(P 2)  →  4 GB   swap"
yellow "    $(P 3)  →  4 GB   /gnu  (Guix store)"
yellow "    $(P 4)  →  rest   /     (root, ext4)"
echo
red    "  ALL DATA ON $DISK WILL BE DESTROYED."
echo
read -rp "  Type YES to continue: " confirm
[[ "$confirm" == "YES" ]] || { echo "Aborted."; exit 0; }

echo
read -rp "  Username [user]: " USERNAME
USERNAME="${USERNAME:-user}"

while true; do
  read -rsp "  Password for $USERNAME: " PASSWORD; echo
  read -rsp "  Confirm password: "        CONFIRM;  echo
  [[ "$PASSWORD" == "$CONFIRM" ]] && break
  yellow "  Passwords do not match, try again."
done

read -rp "  Hostname [brave-origin]: " HOSTNAME
HOSTNAME="${HOSTNAME:-brave-origin}"

DETECTED_TZ="$(timedatectl show --property=Timezone --value 2>/dev/null || echo UTC)"
read -rp "  Timezone [$DETECTED_TZ]: " TIMEZONE
TIMEZONE="${TIMEZONE:-$DETECTED_TZ}"

echo
green "Starting installation…"
echo

# ── 1. Partition ──────────────────────────────────────────────────────────────
bold "[ 1/6 ] Partitioning $DISK…"
sgdisk --zap-all "$DISK"
sgdisk --new=1:0:+1G   --typecode=1:ef00 --change-name=1:"EFI"     "$DISK"
sgdisk --new=2:0:+4G   --typecode=2:8200 --change-name=2:"swap"    "$DISK"
sgdisk --new=3:0:+4G   --typecode=3:8300 --change-name=3:"gnu"     "$DISK"
sgdisk --new=4:0:0     --typecode=4:8300 --change-name=4:"GuixOS"  "$DISK"
partprobe "$DISK"
sleep 1

# ── 2. Format ─────────────────────────────────────────────────────────────────
bold "[ 2/6 ] Formatting…"
mkfs.vfat -F32 -n EFI    "$EFI"
mkswap    -L   swap       "$SWAP"
mkfs.ext4 -L   gnu        "$STORE"
mkfs.ext4 -L   GuixOS     "$ROOT"

# ── 3. Mount ──────────────────────────────────────────────────────────────────
bold "[ 3/6 ] Mounting…"
mount "$ROOT"  /mnt
mkdir -p /mnt/boot/efi /mnt/gnu
mount "$EFI"   /mnt/boot/efi
mount "$STORE" /mnt/gnu
swapon "$SWAP"
mkdir -p /mnt/etc

# ── Collect UUIDs ─────────────────────────────────────────────────────────────
ROOT_UUID="$(blkid -s UUID -o value "$ROOT")"
EFI_UUID="$(blkid -s UUID -o value "$EFI")"
SWAP_UUID="$(blkid -s UUID -o value "$SWAP")"
GNU_UUID="$(blkid -s UUID -o value "$STORE")"

# Hash password for Guix (SHA-512 crypt)
HASHED_PW="$(echo "$PASSWORD" | openssl passwd -6 -stdin)"

# ── 4. Write system config ────────────────────────────────────────────────────
bold "[ 4/6 ] Writing system configuration…"
cat > /mnt/etc/config.scm << CONFIG
;;; /etc/config.scm — Brave Origin Guix System
;;; Generated by brave-origin-install
(use-modules
 (gnu)
 (gnu system)
 (gnu bootloader)
 (gnu bootloader grub)
 (gnu system file-systems)
 (gnu system mapped-devices)
 (gnu services)
 (gnu services base)
 (gnu services networking)
 (gnu services xorg)
 (gnu packages xorg)
 (gnu packages wm)
 (gnu packages terminals)
 (gnu packages fonts)
 (gnu packages admin)
 (brave-origin services brave-origin))

(operating-system
 (host-name "$HOSTNAME")
 (timezone  "$TIMEZONE")
 (locale    "en_US.utf8")

 (keyboard-layout (keyboard-layout "us"))

 (bootloader
  (bootloader-configuration
   (bootloader grub-efi-bootloader)
   (targets '("/boot/efi"))
   (keyboard-layout (keyboard-layout "us"))))

 (swap-devices
  (list (swap-space (target (uuid "$SWAP_UUID")))))

 (file-systems
  (cons*
   (file-system
    (mount-point "/")
    (device (uuid "$ROOT_UUID" 'ext4))
    (type "ext4"))
   (file-system
    (mount-point "/boot/efi")
    (device (uuid "$EFI_UUID" 'fat32))
    (type "vfat"))
   (file-system
    (mount-point "/gnu")
    (device (uuid "$GNU_UUID" 'ext4))
    (type "ext4"))
   %base-file-systems))

 (users
  (cons*
   (user-account
    (name "$USERNAME")
    (comment "Brave Origin user")
    (group "users")
    (password "$HASHED_PW")
    (supplementary-groups '("wheel" "netdev" "audio" "video" "input")))
   %base-user-accounts))

 (packages
  (append
   (list ratpoison xterm font-dejavu git curl htop nss-certs)
   %base-packages))

 (services
  (cons*
   ;; Brave Origin — fetched from the brave-origin channel during init
   (service brave-origin-service-type)

   (service xorg-server-service-type
            (xorg-configuration
             (keyboard-layout (keyboard-layout "us"))))

   (service network-manager-service-type)
   (service wpa-supplicant-service-type)

   %base-services)))
CONFIG

# .xinitrc
mkdir -p "/mnt/home/$USERNAME"
cat > "/mnt/home/$USERNAME/.xinitrc" << 'XINITRC'
#!/bin/sh
xsetroot -cursor_name left_ptr
exec ratpoison
XINITRC

# ── 5. Pull brave-origin channel ─────────────────────────────────────────────
bold "[ 5/6 ] Pulling brave-origin channel…"
mkdir -p /root/.config/guix
cp /etc/channels.scm /root/.config/guix/channels.scm
guix pull --disable-authentication

# ── 6. Init ───────────────────────────────────────────────────────────────────
bold "[ 6/6 ] Running guix system init (Brave Origin fetched from channel)…"
guix system init /mnt/etc/config.scm /mnt

echo
bold "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
green " Done! Remove the USB and reboot."
bold "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo
echo "  reboot"
echo
echo "  After login → startx → Ratpoison"
echo "  Brave Origin: C-t b"
echo
echo "  Optionally apply the home config:"
echo "    guix home reconfigure /etc/brave-origin-templates/home.scm"
echo
