#!/usr/bin/env bash
# brave-origin-install — one-command Guix System + Brave Origin installer
#
# Usage:
#   brave-origin-install /dev/sdX
#   brave-origin-install /dev/nvme0n1
#
# What it does:
#   1. Wipes and partitions the target disk (EFI + root)
#   2. Formats and mounts the partitions
#   3. Writes /mnt/etc/config.scm (brave-origin-service-type included)
#   4. Runs guix system init — Brave Origin is fetched here, not from the ISO
#
# The installed system has:
#   - Brave Origin (via brave-origin channel, fetched during init)
#   - Ratpoison window manager  (startx to launch after first boot)
#   - home.scm ready to apply after `guix pull'
#
set -euo pipefail

# ── Colour helpers ────────────────────────────────────────────────────────────
red()    { printf '\033[1;31m%s\033[0m\n' "$*"; }
green()  { printf '\033[1;32m%s\033[0m\n' "$*"; }
yellow() { printf '\033[1;33m%s\033[0m\n' "$*"; }
bold()   { printf '\033[1m%s\033[0m\n'   "$*"; }
die()    { red "ERROR: $*"; exit 1; }

# ── Root check ────────────────────────────────────────────────────────────────
[[ $EUID -eq 0 ]] || die "Run as root: sudo brave-origin-install /dev/sdX"

# ── Argument ──────────────────────────────────────────────────────────────────
DISK="${1:-}"
[[ -n "$DISK" ]] || { bold "Usage: brave-origin-install /dev/sdX"; exit 1; }
[[ -b "$DISK" ]] || die "$DISK is not a block device"

# ── Detect partition suffix ───────────────────────────────────────────────────
if [[ "$DISK" =~ nvme|mmcblk ]]; then
  EFI="${DISK}p1"
  ROOT="${DISK}p2"
else
  EFI="${DISK}1"
  ROOT="${DISK}2"
fi

# ── Confirm ───────────────────────────────────────────────────────────────────
bold "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
bold " Brave Origin Guix System Installer"
bold "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo
yellow "  Target disk : $DISK"
yellow "  EFI         : $EFI  (512 MiB, FAT32)"
yellow "  Root        : $ROOT (rest of disk, ext4)"
echo
red    "  ALL DATA ON $DISK WILL BE DESTROYED."
echo
read -rp "  Type YES to continue: " confirm
[[ "$confirm" == "YES" ]] || { echo "Aborted."; exit 0; }

# ── Prompts ───────────────────────────────────────────────────────────────────
echo
read -rp "  Username [user]: " USERNAME
USERNAME="${USERNAME:-user}"

while true; do
  read -rsp "  Password for $USERNAME: " PASSWORD; echo
  read -rsp "  Confirm password: "        CONFIRM;  echo
  [[ "$PASSWORD" == "$CONFIRM" ]] && break
  yellow "Passwords do not match, try again."
done

read -rp "  Hostname [brave-origin]: " HOSTNAME
HOSTNAME="${HOSTNAME:-brave-origin}"

DETECTED_TZ="$(timedatectl show --property=Timezone --value 2>/dev/null || echo UTC)"
read -rp "  Timezone [$DETECTED_TZ]: " TIMEZONE
TIMEZONE="${TIMEZONE:-$DETECTED_TZ}"

echo
green "Starting installation…"
echo

# ── 1. Partition ──────────────────────────────────────────────────────────────
bold "[ 1/5 ] Partitioning $DISK…"
sgdisk --zap-all "$DISK"
sgdisk --new=1:0:+512M --typecode=1:ef00 --change-name=1:"EFI"   "$DISK"
sgdisk --new=2:0:0     --typecode=2:8300 --change-name=2:"GuixOS" "$DISK"
partprobe "$DISK"
sleep 1

# ── 2. Format ─────────────────────────────────────────────────────────────────
bold "[ 2/5 ] Formatting…"
mkfs.vfat -F32 -n EFI    "$EFI"
mkfs.ext4 -L   GuixOS    "$ROOT"

# ── 3. Mount ──────────────────────────────────────────────────────────────────
bold "[ 3/5 ] Mounting…"
mount "$ROOT" /mnt
mkdir -p /mnt/boot/efi
mount "$EFI"  /mnt/boot/efi
mkdir -p /mnt/etc

# ── 4. Write system config ────────────────────────────────────────────────────
bold "[ 4/5 ] Writing system configuration…"

# Get the root UUID for fstab
ROOT_UUID="$(blkid -s UUID -o value "$ROOT")"
EFI_UUID="$(blkid -s UUID -o value "$EFI")"

# Hash the password for Guix
HASHED_PW="$(echo "$PASSWORD" | openssl passwd -6 -stdin)"

cat > /mnt/etc/config.scm << CONFIG
;;; /etc/config.scm — Brave Origin Guix System
;;; Generated by brave-origin-install
(use-modules
 (gnu)
 (gnu system)
 (gnu bootloader)
 (gnu bootloader grub)
 (gnu system file-systems)
 (gnu services)
 (gnu services base)
 (gnu services desktop)
 (gnu services networking)
 (gnu services xorg)
 (gnu packages xorg)
 (gnu packages wm)
 (gnu packages terminals)
 (gnu packages fonts)
 (gnu packages admin)
 (brave-origin services brave-origin))

(operating-system
 (host-name "$HOSTNAME")
 (timezone  "$TIMEZONE")
 (locale    "en_US.utf8")

 (keyboard-layout (keyboard-layout "us"))

 (bootloader
  (bootloader-configuration
   (bootloader grub-efi-bootloader)
   (targets '("/boot/efi"))
   (keyboard-layout (keyboard-layout "us"))))

 (file-systems
  (list
   (file-system
    (mount-point "/")
    (device (uuid "$ROOT_UUID" 'ext4))
    (type "ext4"))
   (file-system
    (mount-point "/boot/efi")
    (device (uuid "$EFI_UUID" 'fat32))
    (type "vfat"))))

 (users
  (cons*
   (user-account
    (name "$USERNAME")
    (comment "Brave Origin user")
    (group "users")
    (password (crypt "$PASSWORD" "\$6\$brave"))
    (supplementary-groups '("wheel" "netdev" "audio" "video" "input")))
   %base-user-accounts))

 (packages
  (append
   (list ratpoison xterm font-dejavu git curl htop nss-certs)
   %base-packages))

 (services
  (cons*
   ;; Brave Origin + setuid chrome-sandbox
   ;; (fetched from the brave-origin channel during this init)
   (service brave-origin-service-type)

   ;; Xorg — log in at TTY then run: startx
   (service xorg-server-service-type
            (xorg-configuration
             (keyboard-layout (keyboard-layout "us"))))

   (service network-manager-service-type)
   (service wpa-supplicant-service-type)

   %base-services)))
CONFIG

# Write .xinitrc for the new user
mkdir -p "/mnt/home/$USERNAME"
cat > "/mnt/home/$USERNAME/.xinitrc" << 'XINITRC'
#!/bin/sh
xsetroot -cursor_name left_ptr
exec ratpoison
XINITRC

# ── 5. Init ───────────────────────────────────────────────────────────────────
bold "[ 5/5 ] Running guix system init (Brave Origin fetched from channel)…"

# Set up the brave-origin channel so guix system init can find the modules
mkdir -p /root/.config/guix
cp /etc/channels.scm /root/.config/guix/channels.scm
guix pull --disable-authentication

guix system init /mnt/etc/config.scm /mnt

# ── Done ──────────────────────────────────────────────────────────────────────
echo
bold "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
green " Installation complete!"
bold "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo
echo "  Remove the USB drive and reboot:"
echo
echo "    reboot"
echo
echo "  After login, start the graphical session:"
echo
echo "    startx"
echo
echo "  Brave Origin is in Ratpoison as: C-t b"
echo
echo "  Optionally apply the home config:"
echo
echo "    guix home reconfigure /etc/brave-origin-templates/home.scm"
echo
